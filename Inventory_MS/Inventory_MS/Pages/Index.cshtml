@page
@model InventoryManagement.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

@*
    The heading and the two action buttons stack on phones and only sit side by
    side from the small breakpoint up. Previously they shared one flex row at
    every width, which squeezed the buttons against the heading on mobile.
*@
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-end gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Inventory Dashboard</h1>
        <p class="text-body-secondary mb-0">Master catalogue, stock levels and usage tracking across all categories.</p>
    </div>
    <div class="d-grid d-sm-flex gap-2 flex-shrink-0">
        <a class="btn btn-outline-dark" asp-page="/Usage/Report">Report Usage</a>
        <a class="btn btn-dark" asp-page="/Damage/Report">Report Damage</a>
    </div>
</div>

@*
    The "Low Stock Items" card was removed in v2.2. Low stock is now shown where
    it can be acted on: rows are highlighted on each category inventory page.
*@
<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Master List</h5>
                <div class="display-6 fw-semibold">@Model.MasterCount</div>
                <p class="card-text text-body-secondary small mt-2">All components in the master catalogue.</p>
                <a class="btn btn-outline-dark btn-sm stretched-link" asp-page="/Master/Index">Open Master List</a>
            </div>
        </div>
    </div>

    @{
        var cards = new[]
        {
            ("Electronics", Model.Electronics, "/ElectronicsInventory/Index", "Open Electronics"),
            ("Electrical", Model.Electrical, "/ElectricalInventory/Index", "Open Electrical"),
            ("Tools", Model.Tools, "/ToolsInventory/Index", "Open Tools"),
            ("Modules", Model.Modules, "/ModulesInventory/Index", "Open Modules"),
        };
    }

    @* The tuple element is not called "page": @page is the Razor page directive. *@
    @foreach (var (title, summary, route, linkText) in cards)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@title</h5>
                    <div class="display-6 fw-semibold">@summary.Components</div>
                    <p class="card-text text-body-secondary small mt-2 mb-2">
                        component(s) across @summary.Batches batch row(s) &middot;
                        @summary.RemainingUnits unit(s) remaining.
                    </p>
                    <a class="btn btn-outline-dark btn-sm stretched-link" asp-page="@route">@linkText</a>
                </div>
            </div>
        </div>
    }
</div>
