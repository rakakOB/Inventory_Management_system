@page
@model InventoryManagement.Pages.ElectricalInventory.IndexModel
@{
    ViewData["Title"] = "Electrical Inventory";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Electrical Inventory</h1>
        <p class="text-body-secondary small mb-0">
            @Model.ComponentCount component(s) across @Model.Items.Count batch row(s).
            @if (Model.LowStockCodes.Count > 0)
            {
                <span class="text-danger fw-medium">
                    @Model.LowStockCodes.Count component(s) below the minimum stock alert.
                </span>
            }
        </p>
    </div>
    <div class="d-grid d-sm-block flex-shrink-0">
        <a class="btn btn-dark" asp-page="AddStock">+ Add Stock</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Unique Code</th>
                        <th>Component Name</th>
                        <th>Brand</th>
                        <th class="text-end">Total Qty</th>
                        <th class="text-end">Remaining</th>
                        <th class="text-end">Cost/Unit</th>
                        <th class="text-end">Total Cost</th>
                        <th>Supplier</th>
                        <th>Date</th>
                        <th>Remarks</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-body-secondary py-4">No stock yet. Add the first batch.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        var isLow = Model.LowStockCodes.Contains(item.UniqueCode);
                        <tr class="@(isLow ? "low-stock" : "")">
                            <td class="fw-medium">@item.UniqueCode</td>
                            <td>
                                @item.ComponentName
                                @if (isLow)
                                {
                                    <span class="badge text-bg-danger ms-1">Low stock</span>
                                }
                            </td>
                            <td>@item.Brand</td>
                            <td class="text-end">@item.TotalQuantity</td>
                            <td class="text-end">@item.Remaining</td>
                            <td class="text-end">₹ @item.CostPerUnit.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-end fw-semibold">₹ @item.TotalCost.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@item.Supplier</td>
                            <td>@item.DateOfPurchase</td>
                            <td>@item.Remarks</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@item.RowIndex">Edit</a>
                                    <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@item.RowIndex">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.LowStockCodes.Count > 0)
{
    <p class="text-body-secondary small mt-2 mb-0">
        Highlighted rows belong to a component whose combined remaining stock across
        all of its batches is below the minimum stock alert set in the Master list.
    </p>
}
