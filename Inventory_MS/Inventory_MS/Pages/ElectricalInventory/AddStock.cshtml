@page
@model InventoryManagement.Pages.ElectricalInventory.AddStockModel
@{
    ViewData["Title"] = "Add Stock – Electrical";
}

<h1 class="h3 mb-1">Add Stock</h1>
<p class="text-body-secondary small mb-3">
    Each submission is recorded as a separate batch row, so a component can hold
    several batches with their own invoice, cost, supplier and purchase date.
</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="UniqueCode" class="form-label"></label>
                    <select asp-for="UniqueCode" asp-items="Model.ComponentOptions" class="form-select">
                        <option value="">-- Select component --</option>
                    </select>
                    <span asp-validation-for="UniqueCode" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CostPerUnit" class="form-label"></label>
                    <input asp-for="CostPerUnit" class="form-control" type="number" min="0.01" step="0.01" />
                    <span asp-validation-for="CostPerUnit" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="InvoiceNo" class="form-label"></label>
                    <input asp-for="InvoiceNo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Supplier" class="form-label"></label>
                    <select asp-for="Supplier" asp-items="Model.SupplierOptions" class="form-select">
                        <option value="">-- Select supplier --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="DateOfPurchase" class="form-label"></label>
                    <input asp-for="DateOfPurchase" class="form-control" type="date" />
                </div>
                <div class="col-12">
                    <label asp-for="Remarks" class="form-label"></label>
                    <input asp-for="Remarks" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-dark">Add Stock</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
