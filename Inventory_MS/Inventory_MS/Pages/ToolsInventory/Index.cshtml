@page
@model InventoryManagement.Pages.ToolsInventory.IndexModel
@{
    ViewData["Title"] = "Tools Inventory";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h1 class="h3 mb-1">Tools Inventory</h1>
        <p class="text-muted small mb-0">
            @Model.Tools.Count tool(s) &middot; rows highlighted red are low on stock (Available &lt; 5).
        </p>
    </div>
    <a class="btn btn-dark" asp-page="Create">+ Add Tool</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sl. No.</th>
                        <th>Tool Name</th>
                        <th>Category</th>
                        <th class="text-end">Total Qty</th>
                        <th class="text-end">Available</th>
                        <th>Invoice No.</th>
                        <th class="text-end">Cost/Unit</th>
                        <th class="text-end">Total Cost</th>
                        <th>Supplier</th>
                        <th>Date</th>
                        <th>Remarks</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tools.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">No tools found. Add the first one.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Tools)
                    {
                        <tr class="@(item.IsLowStock ? "table-danger" : "")">
                            <td>@item.SlNo</td>
                            <td class="fw-medium">@item.ToolName</td>
                            <td>@item.Category</td>
                            <td class="text-end">@item.TotalQuantity</td>
                            <td class="text-end">
                                <span class="@(item.IsLowStock ? "text-danger fw-bold" : "")">@item.Available</span>
                            </td>
                            <td>@item.InvoiceNo</td>
                            <td class="text-end">₹ @item.CostPerUnit.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="text-end fw-semibold">₹ @item.TotalCost.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@item.Supplier</td>
                            <td>@item.DateOfPurchase</td>
                            <td>@item.Remarks</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@item.RowIndex">Edit</a>
                                    <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@item.RowIndex">Delete</a>
                                    <a class="btn btn-outline-dark" asp-page="/Damage/Report" asp-route-type="tools" asp-route-rowId="@item.RowIndex">Damage</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
