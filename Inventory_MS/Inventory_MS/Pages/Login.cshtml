@page
@model InventoryManagement.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="card shadow-sm">
    <div class="card-body p-4 p-sm-5">
        <h1 class="h4 mb-1">Inventory Management System</h1>
        <p class="text-body-secondary small mb-4">
            Sign in with the Google account that has been granted access.
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-warning small" role="alert">@Model.Error</div>
        }

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <button type="submit" class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-2">
                <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                    <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.91c1.7-1.57 2.69-3.88 2.69-6.62z" />
                    <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.91-2.26c-.81.54-1.84.86-3.05.86-2.34 0-4.32-1.58-5.03-3.7H1.05v2.34A8.995 8.995 0 0 0 9 18z" />
                    <path fill="#FBBC05" d="M3.97 10.72A5.41 5.41 0 0 1 3.68 9c0-.6.11-1.18.29-1.72V4.94H1.05A8.995 8.995 0 0 0 0 9c0 1.45.35 2.83.96 4.06l3.01-2.34z" />
                    <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A8.995 8.995 0 0 0 1.05 4.94l3.01 2.34C4.68 5.16 6.66 3.58 9 3.58z" />
                </svg>
                Sign in with Google
            </button>
        </form>

        <p class="text-body-secondary small mb-0 mt-4">
            Access is restricted to approved accounts. If you cannot sign in, ask an
            administrator to add your email address to the allowed users list.
        </p>
    </div>
</div>
