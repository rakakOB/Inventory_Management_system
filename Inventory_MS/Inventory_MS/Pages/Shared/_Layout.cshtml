@*
    Main application layout.

    Navigation is grouped into two dropdowns ("Inventory" and "Transactions") so
    the bar stays even on desktop instead of spilling eleven flat links across
    the width, and collapses into a single hamburger on small screens.
*@
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management System</title>
    <partial name="_ThemeHead" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    @* data-bs-theme="dark" keeps the bar dark in both light and dark modes. *@
    <nav class="navbar navbar-expand-lg bg-dark" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-page="/Index">Inventory Management System</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @Active("/Index")" asp-page="/Index">Home</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @Active(InventoryPages)" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">Inventory</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item @Active("/ElectronicsInventory")" asp-page="/ElectronicsInventory/Index">Electronics</a></li>
                            <li><a class="dropdown-item @Active("/ElectricalInventory")" asp-page="/ElectricalInventory/Index">Electrical</a></li>
                            <li><a class="dropdown-item @Active("/ToolsInventory")" asp-page="/ToolsInventory/Index">Tools</a></li>
                            <li><a class="dropdown-item @Active("/ModulesInventory")" asp-page="/ModulesInventory/Index">Modules</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @Active(TransactionPages)" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">Transactions</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item @Active("/Usage/Report")" asp-page="/Usage/Report">Report Usage</a></li>
                            <li><a class="dropdown-item @Active("/Usage/History")" asp-page="/Usage/History">Usage History</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item @Active("/Damage/Report")" asp-page="/Damage/Report">Report Damage</a></li>
                            <li><a class="dropdown-item @Active("/Damage/History")" asp-page="/Damage/History">Damage History</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @Active("/Master")" asp-page="/Master/Index">Master</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("/Suppliers")" asp-page="/Suppliers/Index">Suppliers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("/Reports")" asp-page="/Reports">Reports</a>
                    </li>
                </ul>

                <ul class="navbar-nav align-items-lg-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @Active("/Settings")" asp-page="/Settings">
                                Settings
                                @if (!string.IsNullOrWhiteSpace(SignedInEmail))
                                {
                                    <span class="d-lg-none text-body-secondary small">&middot; @SignedInEmail</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item mt-2 mt-lg-0 ms-lg-2">
                            <form method="post" asp-page="/Logout" class="d-grid d-lg-block">
                                <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @if (TempData["Success"] is string message)
        {
            <div class="alert alert-success" role="alert">@message</div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-body-secondary small border-top py-3">
        Inventory Management System
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private static readonly string[] InventoryPages =
    {
        "/ElectronicsInventory", "/ElectricalInventory", "/ToolsInventory", "/ModulesInventory",
    };

    private static readonly string[] TransactionPages = { "/Usage", "/Damage" };

    private string? CurrentPage => ViewContext.RouteData.Values["page"] as string;

    private string? SignedInEmail =>
        User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

    private string Active(string prefix) =>
        CurrentPage?.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) == true ? "active" : "";

    private string Active(string[] prefixes) =>
        prefixes.Any(p => CurrentPage?.StartsWith(p, StringComparison.OrdinalIgnoreCase) == true) ? "active" : "";
}
