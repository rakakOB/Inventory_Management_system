@page
@model InventoryManagement.Pages.ReportsModel
@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-end gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Reports</h1>
        <p class="text-body-secondary mb-0">
            Download the current contents of any sheet as a CSV file, including all
            columns and headers.
        </p>
    </div>
    <div class="d-grid d-sm-block flex-shrink-0">
        <a class="btn btn-dark" asp-page-handler="Zip">Download All (ZIP)</a>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    @foreach (var report in InventoryManagement.Pages.ReportsModel.Reports)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-1">@report.Title</h5>
                    <p class="card-text text-body-secondary small mb-2">@report.Description</p>
                    <p class="text-body-secondary small mb-3">
                        <code>@report.SheetName</code>
                    </p>
                    <a class="btn btn-outline-dark btn-sm mt-auto align-self-start"
                       asp-page-handler="Csv" asp-route-key="@report.Key">
                        Download CSV
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<p class="text-body-secondary small mt-3 mb-0">
    Files are named after the sheet and the date of export, for example
    <code>Master_@(DateTime.Now.ToString("yyyy-MM-dd")).csv</code>. Data is read live
    when you click, so a download always reflects the current state of the
    spreadsheet.
</p>
