@page
@model InventoryManagement.Pages.Suppliers.EditModel
@{
    ViewData["Title"] = "Edit Supplier";
}

<h1 class="h3 mb-3">Edit Supplier</h1>

<form method="post" asp-route-id="@Model.RowIndex">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="SupplierName" class="form-label"></label>
                    <input asp-for="SupplierName" class="form-control" />
                    <span asp-validation-for="SupplierName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactInfo" class="form-label"></label>
                    <input asp-for="ContactInfo" class="form-control" placeholder="e.g. phone, email, address" />
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-dark">Save Changes</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
