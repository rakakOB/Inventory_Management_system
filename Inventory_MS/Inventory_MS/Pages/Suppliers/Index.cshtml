@page
@model InventoryManagement.Pages.Suppliers.IndexModel
@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-end gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Suppliers</h1>
        <p class="text-body-secondary small mb-0">@Model.Suppliers.Count supplier(s) &middot; used by the category inventories.</p>
    </div>
    <div class="d-grid d-sm-block flex-shrink-0">
        <a class="btn btn-dark" asp-page="Create">+ Create New</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Supplier Name</th>
                        <th>Contact Info</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Suppliers.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">No suppliers yet. Add the first one.</td>
                        </tr>
                    }
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <tr>
                            <td class="fw-medium">@supplier.SupplierName</td>
                            <td>@supplier.ContactInfo</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@supplier.RowIndex">Edit</a>
                                    <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@supplier.RowIndex">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
