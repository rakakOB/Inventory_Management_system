@page
@model InventoryManagement.Pages.Damage.ReportModel
@{
    ViewData["Title"] = "Report Damage";
}

<h1 class="h3 mb-1">Report Damaged Items</h1>
<p class="text-muted small mb-3">
    Select the inventory type and the component. The damaged quantity is deducted
    from stock automatically and written to the damage log.
</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="InventoryType" class="form-label">Inventory Type</label>
                    <select asp-for="InventoryType" class="form-select" id="inventoryType">
                        <option value="pcb">PCB Inventory</option>
                        <option value="tools">Tools Inventory</option>
                        <option value="panel">Panel Inventory</option>
                    </select>
                </div>

                <div class="col-md-8">
                    <label class="form-label">Component / Tool</label>

                    <select name="RowIndex" id="sel-pcb" class="form-select component-select" disabled="@(Model.InventoryType != "pcb")">
                        <option value="">-- Select PCB component --</option>
                        @foreach (var c in Model.PcbComponents)
                        {
                            <option value="@c.RowIndex" data-remaining="@c.Remaining" selected="@(c.RowIndex == Model.RowIndex)">
                                @c.ComponentName &middot; @c.InvoiceNo (Remaining: @c.Remaining)
                            </option>
                        }
                    </select>

                    <select name="RowIndex" id="sel-tools" class="form-select component-select" disabled="@(Model.InventoryType != "tools")">
                        <option value="">-- Select tool --</option>
                        @foreach (var t in Model.Tools)
                        {
                            <option value="@t.RowIndex" data-remaining="@t.Available" selected="@(t.RowIndex == Model.RowIndex)">
                                @t.ToolName &middot; @t.InvoiceNo (Available: @t.Available)
                            </option>
                        }
                    </select>

                    <select name="RowIndex" id="sel-panel" class="form-select component-select" disabled="@(Model.InventoryType != "panel")">
                        <option value="">-- Select panel component --</option>
                        @foreach (var p in Model.PanelComponents)
                        {
                            <option value="@p.RowIndex" data-remaining="@p.Remaining" selected="@(p.RowIndex == Model.RowIndex)">
                                @p.ComponentName &middot; @p.InvoiceNo (Remaining: @p.Remaining)
                            </option>
                        }
                    </select>

                    <div class="form-text" id="stockHint"></div>
                </div>

                <div class="col-md-4">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DamageDate" class="form-label"></label>
                    <input asp-for="DamageDate" class="form-control" type="date" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Reason" class="form-label"></label>
                    <input asp-for="Reason" class="form-control" placeholder="e.g. Broken pin, burnt out" />
                    <span asp-validation-for="Reason" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Remarks" class="form-label"></label>
                    <input asp-for="Remarks" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-dark">Submit Damage Report</button>
    <a class="btn btn-outline-secondary" asp-page="/Damage/History">View History</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const typeSelect = document.getElementById('inventoryType');
        const selects = Array.from(document.querySelectorAll('.component-select'));
        const hint = document.getElementById('stockHint');

        function activeSelect() {
            return selects.find(s => !s.disabled);
        }

        function showStock() {
            const sel = activeSelect();
            const opt = sel && sel.selectedOptions[0];
            hint.textContent = opt && opt.value
                ? 'Available stock: ' + opt.dataset.remaining + ' unit(s)'
                : '';
        }

        function updateSelects() {
            const current = typeSelect.value;
            selects.forEach(s => {
                const active = s.id === 'sel-' + current;
                s.classList.toggle('d-none', !active);
                s.disabled = !active;
            });
            showStock();
        }

        typeSelect.addEventListener('change', updateSelects);
        selects.forEach(s => s.addEventListener('change', showStock));
        updateSelects();
    </script>
}
