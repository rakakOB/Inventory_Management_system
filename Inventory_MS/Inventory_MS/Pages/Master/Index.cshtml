@page
@model InventoryManagement.Pages.Master.IndexModel
@{
    ViewData["Title"] = "Master List";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h1 class="h3 mb-1">Master List</h1>
        <p class="text-muted small mb-0">@Model.Items.Count item(s) &middot; the catalogue behind every category inventory.</p>
    </div>
    <a class="btn btn-dark" asp-page="Create">+ Create New</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Unique Code</th>
                        <th>Component Name</th>
                        <th>Category</th>
                        <th>Brand</th>
                        <th class="text-end">Min. Stock Alert</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No items in the Master list yet.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-medium">@item.UniqueCode</td>
                            <td>@item.ComponentName</td>
                            <td>@item.Category</td>
                            <td>@item.Brand</td>
                            <td class="text-end">@item.MinStockAlert</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary" asp-page="Edit" asp-route-id="@item.RowIndex">Edit</a>
                                    <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@item.RowIndex">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
