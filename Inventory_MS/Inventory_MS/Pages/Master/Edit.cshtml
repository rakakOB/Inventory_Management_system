@page
@model InventoryManagement.Pages.Master.EditModel
@{
    ViewData["Title"] = "Edit Master Item";
}

<h1 class="h3 mb-3">Edit Master Item</h1>

<form method="post" asp-route-id="@Model.Item.RowIndex">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Item.UniqueCode" class="form-label"></label>
                    <input asp-for="Item.UniqueCode" class="form-control" readonly />
                    <div class="form-text">Unique codes cannot be changed; they link the Master list to the inventory sheets.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Item.ComponentName" class="form-label"></label>
                    <input asp-for="Item.ComponentName" class="form-control" />
                    <span asp-validation-for="Item.ComponentName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Item.Category" class="form-label"></label>
                    <select asp-for="Item.Category" class="form-select">
                        <option value="">-- Select category --</option>
                        <option value="Electronics">Electronics</option>
                        <option value="Electrical">Electrical</option>
                        <option value="Tools">Tools</option>
                        <option value="Modules">Modules</option>
                    </select>
                    <span asp-validation-for="Item.Category" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Item.Brand" class="form-label"></label>
                    <input asp-for="Item.Brand" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Item.Unit" class="form-label"></label>
                    <input asp-for="Item.Unit" class="form-control" placeholder="e.g. pcs, meters, sets" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Item.MinStockAlert" class="form-label"></label>
                    <input asp-for="Item.MinStockAlert" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Item.MinStockAlert" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Item.Description" class="form-label"></label>
                    <input asp-for="Item.Description" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-dark">Save Changes</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
