@page
@model InventoryManagement.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}

<div class="card shadow-sm border-danger-subtle">
    <div class="card-body p-4 p-sm-5">
        <h1 class="h4 text-danger mb-2">Access Denied</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <p class="mb-3">
                <span class="fw-medium">@Model.Email</span> is not authorised to use this
                application, so you have been signed out.
            </p>
        }
        else
        {
            <p class="mb-3">
                That account is not authorised to use this application, so you have been
                signed out.
            </p>
        }

        <p class="text-body-secondary small mb-4">
            Ask an administrator to add your email address to the allowed users list,
            then try again.
        </p>

        <a class="btn btn-outline-dark w-100" asp-page="/Login">Back to sign in</a>
    </div>
</div>
